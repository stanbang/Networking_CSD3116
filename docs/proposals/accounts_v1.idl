// J0 REVIEW DRAFT ONLY: not part of the game build. Team + AI, 2026-11-05.
// Proposed destination after approval: idl/accounts.idl. Existing Ast types stay unchanged.
module AstAccount {
  const unsigned short VERSION = 1;
  const unsigned short HELLO = 1;
  const unsigned short REGISTER = 2;
  const unsigned short LOGIN = 3;
  const unsigned short RESUME = 4;
  const unsigned short LOGOUT = 5;
  const unsigned short LEADERBOARD = 6;
  const unsigned short FORGET = 7;
  const unsigned short KEEPALIVE = 8;
  const unsigned short CLOSE = 9;

  const unsigned short OK = 0;
  const unsigned short INVALID_REQUEST = 1;
  const unsigned short INVALID_CREDENTIALS = 2;
  const unsigned short ALREADY_ACTIVE = 3;
  const unsigned short RATE_LIMITED = 4;
  const unsigned short BUSY = 5;
  const unsigned short STORAGE_ERROR = 6;
  const unsigned short NOT_AUTHENTICATED = 7;
  const unsigned short CAPACITY = 8;
  const unsigned short UNSUPPORTED_VERSION = 9;
  const unsigned short REGISTRATION_DENIED = 10;

  @final struct Request {
    unsigned short int_version;
    unsigned short int_operation;
    unsigned long long int_seq;
    octet arr_client_nonce[16];
    octet arr_request_nonce[16];
    octet arr_server_epoch[16];
    octet arr_server_challenge[16];
    octet arr_account_session[16];
    octet arr_resume_token[32];
    unsigned short int_username_length;
    unsigned short int_password_length;
    octet arr_username[24];
    octet arr_password[128];
    boolean b_remember;
  };

  @final struct LeaderEntry {
    unsigned long long int_account_id;
    unsigned long long int_best_score;
    unsigned long long int_updated_unix_s;
    unsigned short int_username_length;
    octet arr_username[24];
  };

  @final struct Response {
    unsigned short int_version;
    unsigned short int_operation;
    unsigned short int_status;
    unsigned long long int_seq;
    unsigned long long int_request_seq;
    octet arr_client_nonce[16];
    octet arr_request_nonce[16];
    octet arr_server_epoch[16];
    octet arr_server_challenge[16];
    octet arr_account_session[16];
    octet arr_resume_token[32];
    unsigned long long int_account_id;
    unsigned long long int_own_best;
    unsigned long long int_token_expiry_unix_s;
    unsigned short int_username_length;
    unsigned short int_entry_count;
    octet arr_username[24];
    boolean b_token_present;
    boolean b_persisted;
    LeaderEntry arr_entries[10];
  };
};

# ---- Build output ----
build/
*.o
*.a
*.so
/server
/client
/baseline-server
/baseline-client

# ---- Generated by idlc (rebuilt by `make`) ----
messages.c
messages.h

# ---- Secrets: NEVER commit private keys or certs ----
security/generated/
*.key
*.pem
*.p12
*.p7s
*.srl
*.csr
.env

# ---- Profiling / debugging artefacts ----
perf.data*
*.perf
callgrind.out.*
cachegrind.out.*
vgcore.*
core
core.*
*.log
asan.*
tsan.*

# ---- Submission media (too large for git; upload to Moodle) ----
*.mp4
*.mov
*.zip

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local packet evidence and Python caches.
*.pcap
*.pcapng
__pycache__/
*.py[cod]

# Account data and private client profiles
*.sqlite3
*.sqlite3-*
*.profile
l[1-6]-*.lock
accounts.lock

# Public offline SDK is distributed separately in the verified source ZIP.
portable/linux-x86_64/

!portable/generated/messages.c
!portable/generated/messages.h
